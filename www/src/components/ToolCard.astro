---
import type { Platform, Tool } from '../data/tools';
import { asset } from '../lib/url';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const platformOrder: Platform[] = ['macos', 'windows', 'linux'];
const platformLabels: Record<Platform, string> = {
  macos: 'MacOS',
  windows: 'Windows',
  linux: 'Linux',
};
const downloadGroups = platformOrder
  .map((platform) => ({
    platform,
    label: platformLabels[platform],
    downloads: tool.downloads.filter((download) => download.platform === platform),
  }))
  .filter((group) => group.downloads.length > 0);
---

<article class="card" data-tool={tool.slug}>
  <header>
    {/* alt="" on purpose: the heading beside it already names the tool, so a
        described icon would just repeat it to a screen reader. */}
    <img class="mark" src={asset(tool.icon)} alt="" width="56" height="56" />
    <div>
      <h2>{tool.displayName}</h2>
      <p class="tagline">{tool.tagline}</p>
    </div>
  </header>

  {tool.description && <p class="description">{tool.description}</p>}

  <div class="download-groups">
    {
      downloadGroups.map((group) => (
        <section class="download-group" aria-labelledby={`${tool.slug}-${group.platform}-downloads`}>
          <h3 id={`${tool.slug}-${group.platform}-downloads`}>{group.label}</h3>
          <ul class="downloads">
            {group.downloads.map((download) => (
              <li>
                <a
                  class="download"
                  href={download.href}
                  data-platform={download.platform}
                >
                  <span class="label">{download.label}</span>
                  <span class="note">{download.note}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <p class="version">
    Version {tool.version} &middot; <code>{tool.slug}</code>
  </p>
</article>

<style>
  .card {
    --card-accent: var(--rd-accent);

    background: var(--rd-surface);
    border: var(--rd-rule-width) solid var(--rd-border);
    border-radius: var(--rd-radius);
    padding: var(--rd-space-4) var(--rd-space-6);
  }

  .card[data-tool='rotpad'] {
    --card-accent: var(--tool-rotpad-accent);
  }

  @media (min-width: 64rem) {
    .card {
      padding: var(--rd-space-6) var(--rd-space-8);
    }
  }

  header {
    display: flex;
    align-items: center;
    gap: var(--rd-space-4);
  }

  /* Lets the name/tagline block shrink instead of pushing the card wide when a
     future tool has a longer display name. */
  header > div {
    min-width: 0;
  }

  /* The generated mark is a full-bleed square; the rounding is the page's
     choice, not baked into the file, so it uses the same corner as everything
     else on the card. */
  .mark {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--rd-radius);
  }

  h2 {
    margin: 0;
    border: 0;
    padding: 0;
  }

  .tagline {
    margin: var(--rd-space-1) 0 0;
    color: var(--rd-ink-muted);
  }

  .description {
    max-width: var(--site-measure);
  }

  .download-groups {
    margin-top: var(--rd-space-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--rd-space-3);
  }

  .download-group {
    display: flex;
    flex-direction: column;
    gap: var(--rd-space-3);
    padding: var(--rd-space-4);
    border: var(--rd-rule-width) solid var(--rd-border);
    border-radius: var(--rd-radius);
    background: var(--rd-canvas);
  }

  .download-group h3 {
    margin: 0;
    border: 0;
    padding: 0;
    color: var(--rd-ink);
    font-size: 0.95rem;
    font-weight: var(--rd-weight-bold);
    line-height: var(--rd-line-height-tight);
  }

  .downloads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--rd-space-2);
  }

  .download {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.05rem;
    min-height: 3rem;
    padding: var(--rd-space-2) var(--rd-space-4);
    border: var(--rd-rule-width) solid var(--rd-border);
    border-radius: var(--rd-radius);
    background: var(--rd-surface);
    color: var(--rd-ink);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .download:hover {
    border-color: var(--card-accent);
    color: var(--rd-ink);
    transform: translateY(-1px);
  }

  .label {
    font-size: 0.9rem;
    font-weight: var(--rd-weight-medium);
    line-height: var(--rd-line-height-tight);
  }

  .note {
    font-size: 0.78rem;
    color: var(--rd-ink-muted);
    line-height: 1.35;
  }

  .version {
    margin: var(--rd-space-6) 0 0;
    font-size: var(--rd-size-small);
    color: var(--rd-ink-muted);
  }
</style>
