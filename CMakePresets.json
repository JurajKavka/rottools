{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Local dev (system wxWidgets)",
      "description": "Uses Homebrew/apt-provided wxWidgets and fetches md4c.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/.cache/fetchcontent/${presetName}"
      }
    },
    {
      "name": "ci-macos",
      "inherits": "ci-base",
      "displayName": "CI macOS (bundled wxWidgets, arm64)",
      "cacheVariables": {
        "ROTTOOLS_USE_BUNDLED_WXWIDGETS": "ON",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      }
    },
    {
      "name": "ci-linux",
      "inherits": "ci-base",
      "displayName": "CI Linux (system wxWidgets from apt)",
      "description": "Uses Ubuntu's wxGTK and WebKitGTK packages; md4c falls back to FetchContent."
    },
    {
      "name": "ci-windows",
      "inherits": "ci-base",
      "displayName": "CI Windows (bundled wxWidgets, x64 static CRT)",
      "cacheVariables": {
        "ROTTOOLS_USE_BUNDLED_WXWIDGETS": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",        "configurePreset": "dev" },
    { "name": "ci-macos",   "configurePreset": "ci-macos",   "configuration": "Release" },
    { "name": "ci-linux",   "configurePreset": "ci-linux",   "configuration": "Release" },
    { "name": "ci-windows", "configurePreset": "ci-windows", "configuration": "Release" }
  ]
}
